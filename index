add(1,7,16,8,'',{bd:1,nm:1});add(1,7,16,7,'Chi tiết lỗi:',{b:1,u:1,a:'l'});add(1,8,16,8,L.va,{c:R,a:'l',ml:1});
add(1,9,12,10,'',{bd:1,nm:1});add(13,9,16,10,'',{bd:1,nm:1});add(1,9,12,9,'Yêu cầu - biện pháp xử lý:',{b:1,u:1,a:'l'});add(13,9,16,9,'Tình trạng xử lý',{b:1,u:1});
