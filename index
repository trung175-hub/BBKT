if(L.oa||L.ob){let y;const pg=()=>{out.push(np());draw(spec(d,L,'BỔ SUNG THÔNG TIN'),d,ims,logo);y=95};pg();
for(const[h,ls]of[['Chi tiết lỗi (đầy đủ):',wrapAt(d.loi,710)],['Yêu cầu - biện pháp xử lý (đầy đủ):',wrapAt(d.bp,710)]]){if(!ls.length||!ls[0]&&ls.length==1)continue;
