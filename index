function spec(d,L,title){const S=[],R=1,add=(c1,r1,c2,r2,t,o)=>S.push([c1,r1,c2,r2,t||'',o||{}]);
add(1,1,3,2,'',{bd:1,logo:1});add(4,1,13,1,'NHÀ MÁY KẾT CẤU THÉP HẢI LONG',{bd:1,b:1,f:14});add(4,2,13,2,title,{bd:1,b:1,f:16});
