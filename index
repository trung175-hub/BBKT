function eo(i,src,p){E={i,src,p:{rot:p.rot,z:p.z,x:p.x,y:p.y},im:null};$('#ed').hidden=false;const im=new Image();im.onload=()=>{E.im=im;sz();de()};im.src=src}
function sz(){const w=Math.min(innerWidth-48,560),h=Math.round(w*FH/FW),r=devicePixelRatio||1,c=$('#ec');c.style.width=w+'px';c.style.height=h+'px';c.width=w*r;c.height=h*r;Object.assign(E,{w,h,r})}
function de(){if(!E||!E.im)return;const g=$('#ec').getContext('2d');g.setTransform(E.r,0,0,E.r,0,0);g.fillStyle='#888';g.fillRect(0,0,E.w,E.h);[E.p.x,E.p.y]=dp(g,E.im,E.p,E.w,E.h);$('#ez').value=E.p.z}
const ec=$('#ec');
ec.onpointerdown=e=>{ec.setPointerCapture(e.pointerId);P.set(e.pointerId,[e.clientX,e.clientY])};
ec.onpointermove=e=>{if(!P.has(e.pointerId)||!E||!E.im)return;const o=P.get(e.pointerId),n=[e.clientX,e.clientY];
if(P.size==1){E.p.x+=(n[0]-o[0])/E.w;E.p.y+=(n[1]-o[1])/E.h}
else if(P.size==2){const t=[...P].find(([k])=>k!=e.pointerId)[1],d0=Math.hypot(o[0]-t[0],o[1]-t[1]),d1=Math.hypot(n[0]-t[0],n[1]-t[1]);if(d0>0)E.p.z=Math.min(6,Math.max(1,E.p.z*d1/d0));E.p.x+=(n[0]-o[0])/2/E.w;E.p.y+=(n[1]-o[1])/2/E.h}
P.set(e.pointerId,n);de()};
ec.onpointerup=ec.onpointercancel=e=>P.delete(e.pointerId);
ec.onwheel=e=>{e.preventDefault();E.p.z=Math.min(6,Math.max(1,E.p.z*(e.deltaY<0?1.08:.93)));de()};
