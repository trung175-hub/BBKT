rows.forEach(([l,v],i)=>{const r=3+i;add(1,r,3,r,l,{bd:1,b:1,a:'l'});add(4,r,8,r,v,{bd:1,c:R});add(9,r,10,r,i<3?'{ký tên}':'',{bd:1})});
add(11,3,16,3,'Phòng: Quản lý chất lượng',{bd:1,a:'l'});
add(11,4,11,4,'Tổ:',{bd:1,b:1,a:'l'});add(12,4,16,4,d.to,{bd:1,c:R,a:'l'});
add(11,5,12,5,'Phân xưởng:',{bd:1,b:1,a:'l'});add(13,5,16,5,TO[d.to]||'',{bd:1,a:'l'});
