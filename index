const IM={},li=async i=>{const p=cur.ph[i];if(!p)return null;if((IM[i]||{}).s===p.src)return IM[i].im;const im=new Image();im.src=p.src;await dec(im);IM[i]={s:p.src,im};return im};
const LG=(()=>{const i=new Image();i.src='data:image/png;base64,'+LOGO;return dec(i).then(()=>i,()=>null)})();
/* ---------- tạo trang A4 (canvas 200 dpi) ---------- */
let G;
