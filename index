</main>

<main id="edit" class="scr" hidden>
<section class="card"><h3>1. Thông tin chung</h3><div class="g2">
<label>Số biên bản<input data-k="so"></label>
<label>Ngày<input type="date" data-k="ng"></label>
<label class="s2">Người kiểm tra<input data-k="nguoi" autocapitalize="words"></label>
<label>Tổ sản xuất (tên)<input data-k="tosx" autocapitalize="words"></label>
