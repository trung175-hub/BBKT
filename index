async function xlsx(d){await lib('ExcelJS');const L=lay(d),wb=new ExcelJS.Workbook(),ws=wb.addWorksheet('Biên bản',{pageSetup:{paperSize:9,orientation:'portrait',fitToPage:true,fitToWidth:1,fitToHeight:1,horizontalCentered:true,margins:{left:.7,right:.25,top:.25,bottom:.25,header:.05,footer:.05},printArea:'A1:P14'}});
for(let c=1;c<=16;c++)ws.getColumn(c).width=5.71;HP.forEach((h,i)=>ws.getRow(i+1).height=h);
const T={style:'thin'};
