return out}
const wrapAt=(t,w)=>{OC.font=FN(16);return wrap(OC,t,w)};
/* ---------- xuất file ---------- */
const LIBS={jspdf:'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js',ExcelJS:'https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js'},lp={};
const lib=k=>window[k]?Promise.resolve():(lp[k]=lp[k]||new Promise((a,b)=>{const e=document.createElement('script');e.src=LIBS[k];e.onload=()=>a();e.onerror=()=>{delete lp[k];b(new Error('Không tải được thư viện xuất file, kiểm tra mạng'))};document.head.appendChild(e)}));
