</style></head><body>
<header><b id="ttl">Biên bản kiểm tra</b><span id="sv"></span></header>

<main id="list" class="scr">
<button id="new" class="pr big">+ Biên bản mới</button>
<div class="row" style="margin:0 0 10px"><button id="bk" style="flex:1">Sao lưu tất cả (.json)</button><button id="rs" style="flex:1">Khôi phục từ file</button></div><input id="rf" type="file" accept=".json,application/json" hidden>
