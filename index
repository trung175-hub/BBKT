/* ---------- vẽ ảnh vào khung (zoom, kéo, xoay) ---------- */
function dp(g,im,p,w,h){const o=p.rot%2,iw=o?im.height:im.width,ih=o?im.width:im.height,s=Math.max(w/iw,h/ih)*p.z,mx=Math.max(0,(iw*s-w)/2),my=Math.max(0,(ih*s-h)/2),x=Math.max(-mx,Math.min(mx,p.x*w)),y=Math.max(-my,Math.min(my,p.y*h));
