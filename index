for(const[c1,r1,c2,r2,t,o]of SP){if((c1!=c2||r1!=r2)&&!o.nm)ws.mergeCells(r1,c1,r2,c2);const k=ws.getCell(r1,c1);
if(o.logo||o.nm||o.ph!==undefined)continue;k.value=t;k.font={name:'Times New Roman',size:o.f||12,bold:!!o.b,underline:!!o.u,color:{argb:'FF000000'}};k.alignment={horizontal:o.a=='l'?'left':'center',vertical:o.ml?'top':'middle',wrapText:!!o.ml}}
for(const[c1,r1,c2,r2,t,o]of SP)if(o.bd)for(let r=r1;r<=r2;r++)for(let c=c1;c<=c2;c++){const b={};if(r==r1)b.top=T;if(r==r2)b.bottom=T;if(c==c1)b.left=T;if(c==c2)b.right=T;const q=ws.getCell(r,c);q.border={...q.border,...b}}
ws.addImage(wb.addImage({base64:LOGO,extension:'png'}),{tl:{col:.2,row:.1},ext:{width:112,height:70}});
for(let i=0;i<4;i++)if(d.ph[i]){const c=i%2*8,r=i<2?10:12;ws.addImage(wb.addImage({base64:await frame(i),extension:'jpeg'}),{tl:{nativeCol:c,nativeColOff:36000,nativeRow:r,nativeRowOff:36000},br:{nativeCol:c+7,nativeColOff:392625,nativeRow:r,nativeRowOff:2411925},editAs:'twoCell'})}
if(L.oa||L.ob){const w2=wb.addWorksheet('Bổ sung');w2.getColumn(1).width=110;let r=1;w2.getCell(1,1).value=`BIÊN BẢN KIỂM TRA ${d.so} - BỔ SUNG THÔNG TIN`;w2.getCell(1,1).font={name:'Times New Roman',bold:true,size:14};r=3;
